{
  "schema_version": 1,
  "version": "1.2.0",
  "pools": {
    "microtopics": {
      "path": "content/microtopics/micro_topics.json",
      "format": "json-map",
      "enabled": true,
      "capabilities": [
        "understand",
        "microtopic"
      ]
    },
    "quickLearn": {
      "path": "content/quick-learn/quick_cards.json",
      "format": "json-map",
      "enabled": true,
      "capabilities": [
        "quick-learn"
      ]
    },
    "deepDive": {
      "path": "content/deep-dive/deep_dive.json",
      "format": "json-map",
      "enabled": true,
      "capabilities": [
        "deep-dive"
      ]
    },
    "activeRecall": {
      "path": "content/active-recall/active_recall.json",
      "format": "json-map",
      "enabled": true,
      "capabilities": [
        "recall",
        "retrieval-practice"
      ]
    },
    "questions": {
      "path": "content/questions/questions.json",
      "format": "question-pool",
      "enabled": true,
      "capabilities": [
        "practice",
        "pyq"
      ]
    },
    "homeLearning": {
      "path": "content/home/home-learning.json",
      "format": "json-object",
      "enabled": true,
      "capabilities": [
        "home"
      ]
    },
    "revisionGuidance": {
      "path": "content/revision/revision_guidance.json",
      "format": "json-map",
      "enabled": true,
      "capabilities": [
        "revision",
        "retrieval-before-review"
      ]
    },
    "practice": {
      "path": "content/practice/practice_mcqs.json",
      "format": "json-map",
      "enabled": true,
      "capabilities": [
        "topic-practice",
        "mcq"
      ]
    }
  },
  "canonicalData": {
    "syllabus": {
      "path": "data/syllabus-index.json",
      "format": "json-object",
      "enabled": true,
      "role": "canonical UGC NET Psychology taxonomy"
    },
    "questionMapping": {
      "path": "data/mcq_mapping.json",
      "format": "json-object",
      "enabled": true,
      "role": "question-to-syllabus mapping and overrides"
    },
    "examSchedule": {
      "path": "data/exam_schedule.json",
      "format": "json-object",
      "enabled": true,
      "role": "exam-date and countdown configuration"
    },
    "ntaPyqRegistry": {
      "path": "data/nta_pyq_registry.json",
      "format": "json-object",
      "enabled": true,
      "role": "NTA/PYQ source registry"
    }
  },
  "canonicalContract": {
    "source": "data/syllabus-index.json",
    "expectedMicrotopics": 549,
    "pools": [
      "microtopics",
      "deepDive",
      "activeRecall",
      "revisionGuidance",
      "practice"
    ],
    "rule": "Canonical micro-topic knowledge is the primary home. Connected Deep Dive, Active Recall, Revision and Practice pools use the same canonical micro-topic IDs. Quick Learn and Daily Learning remain deliberate supplemental learning experiences with their own static content."
  }
}
