{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NET Psychology source register",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "path",
        "type",
        "status",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^sources/inbox/.+"
        },
        "type": {
          "enum": [
            "official-syllabus",
            "textbook",
            "pyq-compilation",
            "unit-notes",
            "research-reference",
            "other"
          ]
        },
        "status": {
          "enum": [
            "available",
            "needs-review",
            "superseded",
            "restricted"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "edition": {
          "type": "string"
        },
        "publisher_or_origin": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
